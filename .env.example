# Copia este archivo como .env y completa los valores. .env NUNCA va a Git.

# --- General ---
APP_ENV=development            # development | test | production (production: logs JSON, sin datos de demo)
APP_NAME="Plataforma Hídrica Zulia"
LOG_LEVEL=INFO
TZ=America/Caracas

# --- Base de datos (PostgreSQL 18 + PostGIS local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plataforma_hidrica
DB_USER=hidrica_app
DB_PASSWORD=cambia-esta-contrasena
DB_NAME_TEST=plataforma_hidrica_test

# --- Seguridad (Iteración 1) ---
JWT_SECRET=genera-una-cadena-aleatoria-larga
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000      # Vercel: URL pública del backend · Docker propio: /api
FRONTEND_URL=http://localhost:5173      # para los enlaces de los correos (recuperación y alertas)

# --- Machine Learning (M6) ---
ML_SATELLITE_SOURCE=sintetico           # sintetico | real (usar "real" con los datos de MINAGUAS)
# ML_MODELS_DIR=/app/ml/models
# ML_REPORTS_DIR=/app/ml/reports

# --- Producción con Docker (Iteración 7) ---
HTTP_PORT=8080                          # puerto del frontend + /api
WEB_WORKERS=2                           # procesos de uvicorn
DOMINIO=                                # p. ej. hidrica.ejemplo.gob.ve (perfil https con Caddy)
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=02

# --- Fuentes satelitales (Iteración 3) ---
# Proveedor del NDWI / superficie de agua: planetary_computer | copernicus | gee | mock
SATELLITE_PROVIDER=mock
# Copernicus Data Space (Sentinel-2) — cuenta gratuita
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Copernicus Climate Data Store (ERA5-Land) — cuenta gratuita
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
# NASA Earthdata (SMAP) — cuenta gratuita, opcional
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Google Earth Engine — opcional, deshabilitado por defecto
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --- Notificaciones (Iteración 6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=                     # bot de Telegram para alertas (opcional)
