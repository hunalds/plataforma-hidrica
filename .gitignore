# --- Secretos (nunca en Git) ---
.env
.env.*
!.env.example
*.pem
*service-account*.json
.netrc

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node / frontend ---
node_modules/
dist/
coverage/
*.local

# --- Datos y modelos (pesados o sensibles) ---
ml/data/raw/*
ml/data/processed/*
ml/models/*
